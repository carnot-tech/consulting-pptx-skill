{
  "$comment": "Rule taxonomy overlay for slide-rules.md. This file does NOT change slide-rules.md's own numbering (its header explicitly says other docs already cite §N.M, so §-numbers stay stable) — it only maps each existing §N.M item to a stable ruleId + category so QA output and Reviewer findings can cite 'which rule' precisely (e.g. TITLE-004) instead of paraphrasing. slide-rules.md remains the canonical text; this index is a pointer table, regenerate-by-hand when §-items are added (append-only, per slide-rules.md's own header note).",
  "categories": ["storyline", "title", "composition", "typography", "chart", "table", "numerical", "language", "source", "visual", "forbidden"],
  "rules": [
    { "id": "STORY-001", "section": "§0.1", "category": "storyline", "summary": "ストーリー設計→型の適応→ファクトチェック→AI癖補正→フレッシュアイの順で作る（型から入らない）" },
    { "id": "STORY-002", "section": "§0", "category": "storyline", "summary": "目的・成果物・スコープIN/OUTを先に3〜5行で合意する" },
    { "id": "STORY-003", "section": "§0", "category": "storyline", "summary": "依頼の背景・期待値（誰から・下書きか提出版か）を先に確認する" },
    { "id": "STORY-004", "section": "§0", "category": "storyline", "summary": "背景が分からない資料は作らない。1枚の論点整理かテキストで出す" },
    { "id": "TITLE-001", "section": "§2.1", "category": "title", "summary": "結論はタイトルに書く。1行基本、長ければ意味の切れ目で2行。文字縮小で1行に詰めない", "forbidden": ["shrink-to-fit title text"] },
    { "id": "TITLE-002", "section": "§2.2", "category": "title", "summary": "常体で書く。です/ます禁止", "forbidden": ["です/ます調のタイトル"] },
    { "id": "TITLE-003", "section": "§2.3", "category": "title", "summary": "普通の文として読める。他スライド参照語（この/その/ここまで）で始めない" },
    { "id": "TITLE-004", "section": "§2.4", "category": "title", "summary": "ページの中身の個数をタイトルに入れない（意味のある数字だけ書く）" },
    { "id": "TITLE-005", "section": "§2.5", "category": "title", "summary": "タイトルを色分けしない", "forbidden": ["<span class=\"ac\"> でのタイトル色分け"] },
    { "id": "TITLE-006", "section": "§2.6", "category": "title", "summary": "タイトルだけ通し読みして1本のストーリーになること" },
    { "id": "TITLE-007", "section": "§2.7", "category": "title", "summary": "Step1等をタイトルに文字連結しない（タグチップで表す）" },
    { "id": "TITLE-008", "section": "§2.8", "category": "title", "summary": "テンプレの見本タイトルは形の参考。プレースホルダー残存はFAIL、同一文型6割以上はWARN", "forbidden": ["◯◯/Text N/ラベルN/YYYY の残存"] },
    { "id": "TITLE-009", "section": "§2.9", "category": "numerical", "summary": "タイトルに書いた数と本文の連番を一致させる" },
    { "id": "TITLE-010", "section": "§2.10", "category": "title", "summary": "チャートのページにはSo whatを必ず載せる" },
    { "id": "TITLE-011", "section": "§2.11", "category": "title", "summary": "事実より強い言い切りをしない。主張の広さは根拠に合わせる" },
    { "id": "TITLE-012", "section": "§2.12", "category": "title", "summary": "タイトルに「見出しラベル：」を前置きしない" },
    { "id": "TITLE-013", "section": "§2.13", "category": "typography", "summary": "2行タイトルは意味の切れ目で明示改行し、泣き別れ（末尾1〜3字）を作らない" },
    { "id": "COMP-001", "section": "§3", "category": "forbidden", "summary": "タイトル直下の説明行・図表直上のラベル行を置かない（軸タイトル1行のみ例外）", "forbidden": ["subtitle()/figttl() の使用", "図表キャプション"] },
    { "id": "COMP-002", "section": "§4.1", "category": "composition", "summary": "1スライド=1メッセージ=1テーマ。2テーマは2枚に分割" },
    { "id": "COMP-003", "section": "§4.2", "category": "composition", "summary": "上下に読ませない。セクションは左右に分ける" },
    { "id": "COMP-004", "section": "§4.3", "category": "composition", "summary": "1スライドに表は1つ。事実/分析は左、意味合いは右" },
    { "id": "COMP-005", "section": "§4.4", "category": "composition", "summary": "図があるスライドは左図・右コメントの2カラム（So What言い切り＋単純な図のみ全幅可）" },
    { "id": "COMP-006", "section": "§4.5", "category": "composition", "summary": "左右カラムの下端を揃える" },
    { "id": "COMP-007", "section": "§4.6", "category": "composition", "summary": "左右カラムには関係が分かる見出しを付ける" },
    { "id": "COMP-008", "section": "§4.7", "category": "composition", "summary": "強い因果があるときだけ横向き三角を挟む" },
    { "id": "COMP-009", "section": "§4.8", "category": "forbidden", "summary": "スライド下部にメッセージボックス（GOAL/KEY/POINT帯）を作らない", "forbidden": ["下部結論帯"] },
    { "id": "COMP-010", "section": "§4.9", "category": "forbidden", "summary": "囲みボックスを乱用しない" },
    { "id": "COMP-011", "section": "§4.10", "category": "table", "summary": "ボックス羅列でなく軸のある表（行=項目・列=観点）" },
    { "id": "COMP-012", "section": "§4.11", "category": "table", "summary": "左右2箱の見比べは行=観点・列=比較対象の表にする" },
    { "id": "COMP-013", "section": "§4.12", "category": "composition", "summary": "余白が出るスライドは垂直中央揃え。引き伸ばしで版面を埋めない", "forbidden": ["内容を伸ばして充填率を稼ぐ"] },
    { "id": "COMP-014", "section": "§4.13", "category": "storyline", "summary": "「まとめ」と「ディープダイブ」を分ける（10枚超で必須）" },
    { "id": "COMP-015", "section": "§4.14", "category": "composition", "summary": "目次は1列" },
    { "id": "COMP-016", "section": "§4.15", "category": "composition", "summary": "並列カード・ボックスは縦幅とスペースを完全に揃える" },
    { "id": "COMP-017", "section": "§4.16", "category": "composition", "summary": "並列要素は内容の粒度・主語も揃える" },
    { "id": "COMP-018", "section": "§4.17", "category": "table", "summary": "ステップ×実現手段は上下の箱でなくテーブルに" },
    { "id": "CHART-001", "section": "§4.18", "category": "chart", "summary": "プロセス・段階は矢羽（シェブロン）を第一候補にする" },
    { "id": "COMP-019", "section": "§4.19", "category": "composition", "summary": "1デッキ内でスライドテンプレートを統一する" },
    { "id": "COMP-020", "section": "§4.20", "category": "composition", "summary": "So Whatは最下部の帯でなく右側セクションに置く" },
    { "id": "COMP-021", "section": "§4.21", "category": "composition", "summary": "左右カラムの見出しは上端を揃える（固定高さ＋下罫線で統一）" },
    { "id": "COMP-022", "section": "§4.22", "category": "composition", "summary": "価格・費用感のstatボックスは右カラムの最下部に置く" },
    { "id": "COMP-023", "section": "§4.23", "category": "composition", "summary": "1カラムに見出しを2つ以上積まない。内側はブレットのインデントで表す" },
    { "id": "COMP-024", "section": "§4.24", "category": "forbidden", "summary": "最後のスライドにメッセージを載せない。締めは裏表紙", "forbidden": ["裏表紙のダークカードCTA"] },
    { "id": "TABLE-001", "section": "§4.25", "category": "table", "summary": "rows・表のセルに2文以上の長文を流し込まない。ブレット化する" },
    { "id": "CHART-002", "section": "§4.26", "category": "chart", "summary": "矢羽の下に別内容の2カラムを積まない。軸タイトルは左右をまたぐ1本線で" },
    { "id": "COMP-025", "section": "§4.27", "category": "composition", "summary": "前提→帰結の2カラムは強い因果があるときだけ横三角矢印で明示する" },
    { "id": "COMP-026", "section": "§4.28", "category": "forbidden", "summary": "宙ぶらりんのフローティングオブジェクトを置かない", "forbidden": ["構造に属さない浮いたラベル・チップ"] },
    { "id": "COMP-027", "section": "§4.29", "category": "composition", "summary": "懸念点・リスクには回避策・対応をセットで付ける" },
    { "id": "COMP-028", "section": "§4.30", "category": "composition", "summary": "レビューコメント・宿題事項は本編に残さずAppendixへ" },
    { "id": "SOURCE-001", "section": "§4.31", "category": "source", "summary": "詳細が後続ページにある要素には参照脚注を置く" },
    { "id": "VISUAL-001", "section": "§4.32", "category": "visual", "summary": "図中の人物・書類はモノクロ単色アイコンで表す。登場人物は原則単数" },
    { "id": "COMP-029", "section": "§4.33", "category": "storyline", "summary": "冒頭で立てた軸は後続スライドで一貫して運ぶ（番号・タグチップ・キッカーの一貫性）" },
    { "id": "COMP-030", "section": "§4.34", "category": "composition", "summary": "論点の多い1枚は段階ビルドアップで2〜3枚に割る（版面を動かさない）" },
    { "id": "COMP-031", "section": "§4.35", "category": "storyline", "summary": "章の各論には一覧ページの番号を持ち込む" },
    { "id": "COMP-032", "section": "§4.36", "category": "composition", "summary": "扱う範囲を絞ったことは、絞った図の上で言う" },
    { "id": "COMP-033", "section": "§4.37", "category": "composition", "summary": "前提・定義・理由は左、具体例・結果・プレイヤーは右" },
    { "id": "COMP-034", "section": "§4.38", "category": "composition", "summary": "表と図の並び順・向きを揃える" },
    { "id": "COMP-035", "section": "§4.39", "category": "composition", "summary": "右カラムの論点は左図の該当箇所に帯とラベルで対応付ける" },
    { "id": "CHART-003", "section": "§4.40", "category": "chart", "summary": "倍率・差分の比較は起点と比較先を矢印で示す" },
    { "id": "CHART-004", "section": "§4.41", "category": "chart", "summary": "順序性のある行には方向を示す軸を添える" },
    { "id": "TABLE-002", "section": "§4.42", "category": "table", "summary": "比較は前出の図と同じ軸で表にして検証できる形にする" },
    { "id": "COMP-036", "section": "§4.43", "category": "storyline", "summary": "問題ページの後には解消ページを対で置き、タイトルを「越えられる」形にする" },
    { "id": "STORY-005", "section": "§4.44", "category": "storyline", "summary": "章のストーリーは1枚ごとに1段ずつ進める。1枚に2段以上詰めない" },
    { "id": "COMP-037", "section": "§4.45", "category": "composition", "summary": "章扉の作法。無理に章分けしない（10枚前後は不要）" },
    { "id": "VISUAL-002", "section": "§4.46", "category": "visual", "summary": "図中の例示は実名で複数並べ、当事者に関わるものは最上段に揃える" },
    { "id": "SOURCE-002", "section": "§4.47", "category": "source", "summary": "出典・注釈の定位置は左下（フッターの1行上）。タイトルや表名に出典を書かない" },
    { "id": "CHART-005", "section": "§4.48", "category": "chart", "summary": "バリューチェーン・工程の帯は細く全幅に敷き、説明は帯の下にカラムで置く" },
    { "id": "COMP-038", "section": "§4.49", "category": "composition", "summary": "カラム見出しは単独で読んで意味が通る語にする（接続詞始まり禁止）" },
    { "id": "VISUAL-003", "section": "§5.1", "category": "visual", "summary": "角丸は既定で使わない（小ピル除く）", "forbidden": ["roundRect / border-radius>=4px"] },
    { "id": "VISUAL-004", "section": "§5.2", "category": "visual", "summary": "ボックスの色を変えるなら同一スライドに凡例。意味のない強調禁止" },
    { "id": "VISUAL-005", "section": "§5.3", "category": "visual", "summary": "塗りのあるボックスに枠線を付けない", "forbidden": ["塗り+枠線"] },
    { "id": "VISUAL-006", "section": "§5.4", "category": "visual", "summary": "罫線は区切る対象がある場所にだけ引く（最終行・最下部に引かない）", "forbidden": ["行き先のない罫線"] },
    { "id": "VISUAL-007", "section": "§5.5", "category": "visual", "summary": "比較表のハイライトは勝っている側に付ける" },
    { "id": "VISUAL-008", "section": "§5.6", "category": "visual", "summary": "競合比較には相手が勝つ軸を必ず入れる" },
    { "id": "SOURCE-003", "section": "§5.7", "category": "source", "summary": "自社実測値には測定条件の注釈（対象・件数・検証主体）" },
    { "id": "VISUAL-009", "section": "§5.8", "category": "visual", "summary": "意味を持つ色（✕赤等）はリブランド時も保持。製品UIスクショは無加工" },
    { "id": "VISUAL-010", "section": "§5.9", "category": "visual", "summary": "色分けパレットにモノトーンを含める。全カテゴリを有彩色で塗らない" },
    { "id": "CHART-006", "section": "§5.10", "category": "chart", "summary": "上限が定義された指標のチャートはフルスケールで描く" },
    { "id": "CHART-007", "section": "§5.11", "category": "chart", "summary": "推移・構成比・分布はグラフで描く（表に流し込まない）" },
    { "id": "CHART-008", "section": "§5.12", "category": "chart", "summary": "チャートは基本形①〜④から選ぶ。応用形は当てはまらないときだけ" },
    { "id": "COMP-039", "section": "§5.13", "category": "composition", "summary": "版面充填率は55%以上。飾りで埋めない・伸ばして稼がない", "forbidden": ["空白埋めの装飾（矢印アイコン・帯）"] },
    { "id": "TABLE-003", "section": "§6", "category": "table", "summary": "表ヘッダーは本文より2pt大きく太字・塗りなし。軸は罫線で表現" },
    { "id": "TABLE-004", "section": "§6", "category": "table", "summary": "行間は細い薄罫線1本。最終行の下は罫線なし" },
    { "id": "TABLE-005", "section": "§6", "category": "table", "summary": "列名は省略語・造語禁止。各セルが単独で分かる自然語" },
    { "id": "TABLE-006", "section": "§6", "category": "typography", "summary": "表・rowsの本文は11.5pt以上、th=本文+2pt、行見出し軸=本文+4pt" },
    { "id": "TABLE-007", "section": "§6", "category": "table", "summary": "詳細セルは2件以上ならブレット2〜3個で列挙する" },
    { "id": "SOURCE-004", "section": "§6", "category": "source", "summary": "出典はタイトルや表名に書かない。左下の定位置へ" },
    { "id": "TABLE-008", "section": "§6", "category": "table", "summary": "非該当セルは「—」でグレー塗りにして非強調にする" },
    { "id": "TABLE-009", "section": "§6", "category": "table", "summary": "行は左端列の軸ラベルが定義する集合の要素だけにする（軸外の事実を混ぜない）" },
    { "id": "TABLE-010", "section": "§6", "category": "table", "summary": "列は主張に必要なものだけ置く（効かない列は削る）" },
    { "id": "TABLE-011", "section": "§6", "category": "table", "summary": "列見出しは中身を指す具体名詞にする（抽象語禁止）" },
    { "id": "TABLE-012", "section": "§6", "category": "table", "summary": "列の粒度を揃える（別カテゴリの内容を混ぜない）" },
    { "id": "TABLE-013", "section": "§6", "category": "table", "summary": "変化しない事実は書かない。差分説明の表は変わったことだけ書く" },
    { "id": "LANG-001", "section": "§7 冒頭", "category": "language", "summary": "AIぽさの3要因: フローティングボックス／ブレットなしの冗長説明／主語述語を抜いた圧縮語" },
    { "id": "LANG-002", "section": "§7.1", "category": "language", "summary": "丸括弧を多用しない。「 — 」連結を使わない" },
    { "id": "LANG-003", "section": "§7.2", "category": "language", "summary": "勝手な短縮・造語禁止。一読で伝わる完全な自然語" },
    { "id": "LANG-004", "section": "§7.3", "category": "language", "summary": "ブレットのマーカーは書式（buChar/CSSマーカー）で付ける。テキスト直打ち禁止", "forbidden": ["「•」の本文直打ち"] },
    { "id": "LANG-005", "section": "§7.4", "category": "language", "summary": "ブレットの語尾は同じ階層内で必ず揃える。ですます調禁止" },
    { "id": "LANG-006", "section": "§7.5", "category": "language", "summary": "脚注的な小さな注記も極力本文へ統合" },
    { "id": "LANG-007", "section": "§7.6", "category": "language", "summary": "1資料1用語。表記ゆれ禁止。略語は初出でフル表記" },
    { "id": "LANG-008", "section": "§7.7", "category": "language", "summary": "比喩的・造語的な用語には「」を付けて定義する" },
    { "id": "LANG-009", "section": "§7.8", "category": "language", "summary": "最終聴衆にチェックしてほしい論点を明示する" },
    { "id": "LANG-010", "section": "§7.9", "category": "language", "summary": "AI臭ワード・言い回しを除去する（ai-smell-lexicon.md参照）" },
    { "id": "LANG-011", "section": "§7.10", "category": "language", "summary": "機能・プロセス説明のブレットは主語（ユーザー/AI）で始める" },
    { "id": "LANG-012", "section": "§7.11", "category": "language", "summary": "社内メタファー・内輪用語を外部資料に持ち込まない" },
    { "id": "LANG-013", "section": "§7.12", "category": "language", "summary": "文中の記号連結でなく構造（列・見出し帯・インデント）で表す" },
    { "id": "LANG-014", "section": "§7.13", "category": "language", "summary": "番号・記号・ラベルは後続で参照する予定があるときだけ導入する" },
    { "id": "LANG-015", "section": "§7.14", "category": "language", "summary": "本文・ブレットでも主語と述語を落とさない" },
    { "id": "LANG-016", "section": "§7.15", "category": "language", "summary": "AI生成の日本語は納品前に日本語話者が読み直す" },
    { "id": "STORY-006", "section": "§7.16", "category": "storyline", "summary": "エグゼクティブサマリーは本文タイトル列に対応させ3階層に構造化する" },
    { "id": "LANG-017", "section": "§7.17", "category": "language", "summary": "図の下の注記は無くて通じるなら消す" },
    { "id": "LANG-018", "section": "§7.18", "category": "language", "summary": "並列ブレットが4本以上あり括りが作れるなら2つの親に束ねる" },
    { "id": "QA-001", "section": "§8", "category": "visual", "summary": "16:9サイズ・角丸・枠線・表ヘッダー・罫線・数の一致など機械チェック必須項目一覧（check_deck.py）" },
    { "id": "QA-002", "section": "§8", "category": "composition", "summary": "HTMLレイアウト検査（check_layout.mjs）: フッター重なり・タイトルはみ出し" },
    { "id": "QA-003", "section": "§8", "category": "storyline", "summary": "フレッシュアイ・レビュー必須（最終工程）" }
  ]
}
