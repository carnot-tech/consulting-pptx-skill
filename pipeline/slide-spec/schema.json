{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consulting SlideSpec",
  "type": "object",
  "required": [
    "deckTitle",
    "slides"
  ],
  "properties": {
    "deckTitle": {
      "type": "string"
    },
    "deckSubtitle": {
      "type": "string"
    },
    "skin": {
      "enum": [
        "cool",
        "warm"
      ],
      "description": "Deck color/type skin. cool (default) = white/near-black/navy+cyan/sans. warm = cream/espresso/brown/serif, editorial."
    },
    "viewer": {
      "type": "boolean",
      "description": "Emit the scale-to-fit on-screen viewer wrapper."
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "required": [
        "template",
        "title"
      ],
      "properties": {
        "template": {
          "enum": [
            "cover",
            "executive_summary",
            "big_stat_pair",
            "numbered_imperatives",
            "theme_card_grid",
            "question_framework",
            "evidence_basis",
            "chart_insight",
            "comparison_table",
            "roadmap",
            "waterfall",
            "matrix_2x2",
            "issue_tree",
            "scenario_table",
            "risk_table",
            "kpi_dashboard",
            "small_multiples",
            "recommendation_pillars",
            "decision_page",
            "cause_effect",
            "process_flow",
            "cycle",
            "decision_fork",
            "chevron_rail",
            "gantt",
            "scr",
            "horizontal_axis_table",
            "issue_to_solution_map",
            "issue_cause_solution",
            "current_target_state",
            "heatmap_table",
            "timeline_matrix",
            "process_matrix",
            "stacked_bar",
            "true_waterfall",
            "nested_row_matrix",
            "calc_flow",
            "chevron_value_chain",
            "title_page",
            "overview_map",
            "table_of_contents",
            "section_divider",
            "chevron_steps",
            "premise_conclusion",
            "stat_table_readout",
            "card_grid_2x2",
            "axis_table",
            "back_cover",
            "claim_panel_figure",
            "lever_effect_table",
            "status_heatmap_comment",
            "harvey_ball_table",
            "dot_matrix_share",
            "progress_bubble_matrix",
            "ranked_bar_annotated",
            "scatter_annotated",
            "pillars_foundation",
            "opposing_chevrons",
            "evidence_clip_grid",
            "proportional_circles",
            "delta_bars_totals",
            "scenario_lines_cagr",
            "research_basis",
            "issue_action_columns",
            "agenda_separator"
          ]
        },
        "title": {
          "type": "string"
        },
        "kicker": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "chart": {
          "$ref": "#/$defs/chart"
        },
        "table": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "headers": {
          "type": "object",
          "description": "Localizable table/label headers. comparison_table: criterion/company/competitor/implication. scenario_table: case/outcome/assumptions/implication. risk_table: risk/signal/mitigation/owner. cause_effect: effect. issue_to_solution_map: issue/resolution. timeline_matrix: phase. gantt: milestone. decision_page: recommended. English defaults keep old specs working; Japanese decks should set these.",
          "properties": {
            "criterion": {
              "type": "string"
            },
            "company": {
              "type": "string"
            },
            "competitor": {
              "type": "string"
            },
            "implication": {
              "type": "string"
            },
            "case": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            },
            "assumptions": {
              "type": "string"
            },
            "risk": {
              "type": "string"
            },
            "signal": {
              "type": "string"
            },
            "mitigation": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "effect": {
              "type": "string"
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ask": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scr": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/scrColumn"
          }
        },
        "axis": {
          "$ref": "#/$defs/axisTable"
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mapping"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "stages": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "panels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "fork": {
          "$ref": "#/$defs/fork"
        },
        "heatmap": {
          "$ref": "#/$defs/heatmap"
        },
        "lanes": {
          "$ref": "#/$defs/lanes"
        },
        "grid": {
          "$ref": "#/$defs/grid"
        },
        "stacks": {
          "$ref": "#/$defs/stacks"
        },
        "causeEffect": {
          "$ref": "#/$defs/causeEffect"
        },
        "gantt": {
          "$ref": "#/$defs/gantt"
        },
        "tree": {
          "$ref": "#/$defs/tree"
        },
        "nested": {
          "$ref": "#/$defs/nested"
        },
        "calc": {
          "$ref": "#/$defs/calc"
        },
        "valueChain": {
          "$ref": "#/$defs/valueChain"
        },
        "kpis": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/kpi"
          }
        },
        "multiples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/multiple"
          }
        },
        "parts": {
          "type": "object",
          "description": "自由記述パーツ由来の型（scripts/archetypes/*.mjs）が使うデータ。中身の形は各型モジュールの example を見る"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "template": {
                "const": "scr"
              }
            }
          },
          "then": {
            "required": [
              "scr"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "horizontal_axis_table"
              }
            }
          },
          "then": {
            "required": [
              "axis"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "issue_to_solution_map"
              }
            }
          },
          "then": {
            "required": [
              "mappings"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "process_flow"
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "cycle"
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "issue_cause_solution"
              }
            }
          },
          "then": {
            "required": [
              "stages"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "current_target_state"
              }
            }
          },
          "then": {
            "required": [
              "panels"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "decision_fork"
              }
            }
          },
          "then": {
            "required": [
              "fork"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "heatmap_table"
              }
            }
          },
          "then": {
            "required": [
              "heatmap"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "timeline_matrix"
              }
            }
          },
          "then": {
            "required": [
              "lanes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "process_matrix"
              }
            }
          },
          "then": {
            "required": [
              "grid"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "stacked_bar"
              }
            }
          },
          "then": {
            "required": [
              "stacks"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "true_waterfall"
              }
            }
          },
          "then": {
            "required": [
              "chart"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "nested_row_matrix"
              }
            }
          },
          "then": {
            "required": [
              "nested"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "calc_flow"
              }
            }
          },
          "then": {
            "required": [
              "calc"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "chevron_value_chain"
              }
            }
          },
          "then": {
            "required": [
              "valueChain"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "cause_effect"
              }
            }
          },
          "then": {
            "required": [
              "causeEffect"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "chevron_rail"
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "gantt"
              }
            }
          },
          "then": {
            "required": [
              "gantt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "issue_tree"
              }
            }
          },
          "then": {
            "required": [
              "tree"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "kpi_dashboard"
              }
            }
          },
          "then": {
            "required": [
              "kpis"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "recommendation_pillars"
              }
            }
          },
          "then": {
            "required": [
              "sections"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "small_multiples"
              }
            }
          },
          "then": {
            "required": [
              "multiples"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "big_stat_pair"
              }
            }
          },
          "then": {
            "required": [
              "kpis"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "numbered_imperatives"
              }
            }
          },
          "then": {
            "required": [
              "sections"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "theme_card_grid"
              }
            }
          },
          "then": {
            "required": [
              "sections"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "question_framework"
              }
            }
          },
          "then": {
            "required": [
              "sections"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "evidence_basis"
              }
            }
          },
          "then": {
            "required": [
              "sections"
            ]
          }
        }
      ]
    },
    "scrColumn": {
      "type": "object",
      "required": [
        "label",
        "heading"
      ],
      "properties": {
        "label": {
          "type": "string",
          "description": "Column label — free text. English (Situation/Complication/Resolution) or a localized/scene label (例: 現状/課題/打ち手) both work; no fixed wording is enforced."
        },
        "heading": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "axisTable": {
      "type": "object",
      "required": [
        "headers",
        "rows"
      ],
      "properties": {
        "callout": {
          "type": "string"
        },
        "flow": {
          "type": "boolean"
        },
        "rowBanner": {
          "type": "boolean"
        },
        "dotColumn": {
          "type": "integer",
          "minimum": 0
        },
        "dotLegend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "headers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "cells"
            ],
            "properties": {
              "cells": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "highlight": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": [
        "issue",
        "solution"
      ],
      "properties": {
        "issue": {
          "type": "string"
        },
        "solution": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "label",
        "heading"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        }
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone": {
          "enum": [
            "neutral",
            "current",
            "target"
          ]
        }
      }
    },
    "fork": {
      "type": "object",
      "required": [
        "question",
        "branches"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "copy": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              },
              "recommended": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "heatmap": {
      "type": "object",
      "required": [
        "colHeaders",
        "rows"
      ],
      "properties": {
        "rowLabel": {
          "type": "string"
        },
        "colHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label",
              "cells"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "level"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "lanes": {
      "type": "object",
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "period",
              "cells"
            ],
            "properties": {
              "period": {
                "type": "string"
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "colHeaders",
        "rows"
      ],
      "properties": {
        "rowLabel": {
          "type": "string"
        },
        "colHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label",
              "cells"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "causeEffect": {
      "type": "object",
      "required": [
        "effect",
        "causes"
      ],
      "properties": {
        "effect": {
          "type": "string"
        },
        "causes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "gantt": {
      "type": "object",
      "required": [
        "periods",
        "rows"
      ],
      "properties": {
        "periods": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "periodBands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "span"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "span": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "label"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label",
              "start",
              "span"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "span": {
                "type": "integer",
                "minimum": 1
              },
              "ongoing": {
                "type": "boolean"
              },
              "phase": {
                "enum": [
                  "plan",
                  "build",
                  "scale"
                ]
              }
            }
          }
        }
      }
    },
    "tree": {
      "type": "object",
      "required": [
        "root",
        "branches"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "nested": {
      "type": "object",
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "rows"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
